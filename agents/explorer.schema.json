{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["ready", "escalate"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ambiguities": {
      "type": "array",
      "description": "Only questions that block safe implementation. Must be empty for ready.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_predicate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommended_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "decision",
    "summary",
    "relevant_files",
    "constraints",
    "risks",
    "ambiguities",
    "success_predicate",
    "recommended_tests",
    "confidence"
  ]
}
